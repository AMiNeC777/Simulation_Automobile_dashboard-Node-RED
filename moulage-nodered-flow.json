    {
        "id": "a100000000000009",
        "type": "function",
        "z": "f10a000000000001",
        "name": "Traducteur commandes",
        "func": "let action = null;\nif (msg.topic === \"speed\") action = \"SET_SPEED\";\nelse if (typeof msg.payload === \"string\") action = msg.payload;\nelse if (msg.action) action = msg.action;\n\nif (action === \"START\" && flow.get(\"inhibitRestart\")) {\n    return [null, { payload: \"Redémarrage inhibé. Actionnez Réinitialiser.\" }];\n}\n\nif (action === \"SET_SPEED\") {\n    const raw = Number(msg.value != null ? msg.value : msg.payload);\n    let speed = Math.round(raw / 10);\n    if (!Number.isFinite(speed) || speed < 1) speed = 1;\n    if (speed > 10) speed = 10;\n    return [{ cmd: \"setSpeed\", value: speed }, null];\n}\n\nconst map = {\n    START: \"start\",\n    STOP: \"pause\",\n    EMERGENCY_STOP: \"stop\",\n    RESET: \"reset\"\n};\nconst cmd = map[action];\nif (!cmd) return [null, null];\n\nif (action === \"RESET\") {\n    flow.set(\"inhibitRestart\", false);\n    flow.set(\"totalCount\", 0);\n    flow.set(\"conformeCount\", 0);\n    flow.set(\"defectTotal\", 0);\n    flow.set(\"defectStreak\", 0);\n    return [\n        { cmd: \"reset\" },\n        { payload: \"—\" },\n        { payload: 0 },\n        { payload: 0 },\n        { payload: 0 },\n        { payload: 0 },\n        { payload: \"—\" },\n        { payload: \"Prête\" }\n    ];\n}\n\nreturn [{ cmd: cmd }, null];",
