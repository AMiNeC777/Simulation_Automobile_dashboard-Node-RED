    {
        "id": "a100000000000006",
        "type": "function",
        "z": "f10a000000000001",
        "name": "État machine",
        "func": "const p = msg.payload || {};\nconst status = p.status || \"\";\nconst temp = Number(p.temp);\nconst streak = (p.defectStreak != null && p.defectStreak !== \"\")\n    ? (Number(p.defectStreak) || 0)\n    : (flow.get(\"defectStreak\") || 0);\nif (p.defectStreak != null && p.defectStreak !== \"\") flow.set(\"defectStreak\", streak);\n\nconst locked = status === \"Surchauffe\" || status === \"Arrêt Sécurité Qualité\";\nif (locked) flow.set(\"inhibitRestart\", true);\n\nconst reset = p.reason === \"réinitialisation\" || status === \"Prête\";\nif (reset) {\n    flow.set(\"inhibitRestart\", false);\n    flow.set(\"totalCount\", 0);\n    flow.set(\"conformeCount\", 0);\n    flow.set(\"defectTotal\", 0);\n    flow.set(\"defectStreak\", 0);\n}\n\nlet alert = \"—\";\nif (locked) alert = \"ALERTE : \" + status + \" — redémarrage inhibé\";\n\nlet prevention = { payload: \"—\" };\nif (!reset && (temp > 210 || streak === 2)) {\n    const bits = [];\n    if (temp > 210) bits.push(\"température \" + temp + \" °C\");\n    if (streak === 2) bits.push(\"2 rebuts consécutifs\");\n    prevention = { payload: \"Dérive : \" + bits.join(\" — \") };\n}\n\nconst tempMsg = { payload: Number.isFinite(temp) ? temp : \"\" };\nconst statusMsg = { payload: status || \"—\" };\nconst alertMsg = { payload: reset ? \"—\" : alert };\n\nif (reset) {\n    return [\n        statusMsg,\n        alertMsg,\n        tempMsg,\n        prevention,\n        { payload: 0 },\n        { payload: 0 },\n        { payload: 0 },\n        { payload: 0 }\n    ];\n}\n\nreturn [\n    statusMsg,\n    alertMsg,\n    tempMsg,\n    prevention,\n    null,\n    null,\n    null,\n    null\n];",
        "outputs": 8,
        "timeout": 0,
        "noerr": 0,
