    {
        "id": "a100000000000005",
        "type": "function",
        "z": "f10a000000000001",
        "name": "Compteurs pièce",
        "func": "const p = msg.payload || {};\nlet total = flow.get(\"totalCount\") || 0;\nlet ok = flow.get(\"conformeCount\") || 0;\nlet ko = flow.get(\"defectTotal\") || 0;\nlet streak = flow.get(\"defectStreak\") || 0;\n\nif (p.totalCount != null && p.totalCount !== \"\") {\n    total = Number(p.totalCount) || 0;\n    ok = Number(p.conformeCount) || 0;\n    ko = Number(p.defectTotal) || 0;\n    streak = Number(p.defectCount != null ? p.defectCount : streak) || 0;\n} else {\n    total += 1;\n    if (p.status === \"Non-Conforme\") {\n        ko += 1;\n        streak += 1;\n    } else {\n        ok += 1;\n        streak = 0;\n    }\n}\n\nflow.set(\"totalCount\", total);\nflow.set(\"conformeCount\", ok);\nflow.set(\"defectTotal\", ko);\nflow.set(\"defectStreak\", streak);\n\nconst taux = total ? Math.round((ko / total) * 1000) / 10 : 0;\nconst trs = total ? Math.round((ok / total) * 1000) / 10 : 0;\nconst temp = Number(p.temp);\n\nconst row = {\n    id: p.id || \"\",\n    timestamp: p.timestamp || \"\",\n    temp: Number.isFinite(temp) ? temp : \"\",\n    status: p.status || \"\",\n    motif: p.motif || \"\",\n    totalCount: total,\n    conformeCount: ok,\n    defectTotal: ko,\n    defectCount: streak,\n    tauxRebut: taux,\n    trs: trs\n};\n\nlet prevention = { payload: \"—\" };\nif (temp > 210 || streak === 2) {\n    const bits = [];\n    if (temp > 210) bits.push(\"température \" + temp + \" °C\");\n    if (streak === 2) bits.push(\"2 rebuts consécutifs\");\n    prevention = { payload: \"Dérive : \" + bits.join(\" — \") };\n}\n\nlet header = null;\nif (!flow.get(\"csvHeaderWritten\")) {\n    flow.set(\"csvHeaderWritten\", true);\n    header = { payload: \"id;timestamp;temp;status;motif;totalCount;conformeCount;defectTotal;defectCount;tauxRebut;trs\\r\\n\" };\n}\n\nreturn [\n    { payload: row },\n    { payload: total },\n    { payload: ok },\n    { payload: ko },\n    { payload: Number.isFinite(temp) ? temp : \"\" },\n    { payload: taux, topic: \"Taux de rebut\" },\n    { payload: trs },\n    prevention,\n    header\n];",
        "outputs": 9,
        "timeout": 0,
        "noerr": 0,
