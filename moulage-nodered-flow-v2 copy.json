        "z": "f20b000000000001",
        "name": "Traiter statut",
        "func": "const p = msg.payload || {};\nconst status = p.status || \"—\";\nconst temp = Number(p.temp);\nconst critical = status === \"Surchauffe\" || status === \"Arrêt Sécurité Qualité\" || status === \"Arrêt Sécurité\";\n\nlet bg = \"#475569\";\nlet color = \"#f8fafc\";\nif (status === \"En Marche\") bg = \"#059669\";\nelse if (critical) {\n    bg = \"#dc2626\";\n    color = \"#ffffff\";\n}\n\nreturn [\n    { payload: status, flash: critical, bg: bg, color: color },\n    { payload: p.bottleneck === true ? \"Goulot d'Étranglement (Emballage Surchargé)\" : \"—\" },\n    { payload: p.challengeActive === true ? \"Mode Défi en Cours\" : \"—\" },\n    Number.isFinite(temp) ? { payload: temp } : null\n];",
