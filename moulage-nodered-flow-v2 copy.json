    {
        "id": "c20000000000000b",
        "type": "function",
        "z": "f20b000000000001",
        "name": "Commande JSON",
        "func": "let action = null;\nlet value = null;\n\nif (msg.topic === \"SET_SPEED\" || msg.topic === \"SET_TEMP\") {\n    action = msg.topic;\n    value = Math.round(Number(msg.payload));\n    if (!Number.isFinite(value)) return null;\n    if (action === \"SET_SPEED\") value = Math.min(100, Math.max(10, value));\n    if (action === \"SET_TEMP\") value = Math.min(250, Math.max(150, value));\n} else if (typeof msg.payload === \"string\" && msg.payload) {\n    action = msg.payload;\n} else if (msg.action) {\n    action = msg.action;\n    if (msg.value != null) value = msg.value;\n}\n\nif (!action) return null;\n\nconst out = { action: action, payload: { action: action } };\nif (value != null && Number.isFinite(Number(value))) {\n    out.value = Number(value);\n    out.payload.value = Number(value);\n}\nreturn out;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 560,
