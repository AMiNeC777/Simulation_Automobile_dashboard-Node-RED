        "func": "let data = msg;\nif (!data.type && typeof data.payload === \"string\") {\n    try {\n        const parsed = JSON.parse(data.payload);\n        if (parsed && typeof parsed === \"object\") data = parsed;\n    } catch (e) {\n        return null;\n    }\n}\nif (!data.type && data.payload && typeof data.payload === \"object\" && data.payload.type) {\n    data = { type: data.payload.type, payload: data.payload.payload };\n}\nif (!data.type || data.payload == null || typeof data.payload !== \"object\") return null;\nmsg.type = data.type;\nmsg.payload = data.payload;\nreturn msg;",
