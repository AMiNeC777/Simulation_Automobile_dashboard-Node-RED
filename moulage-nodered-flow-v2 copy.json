    {
        "id": "c200000000000006",
        "type": "function",
        "z": "f20b000000000001",
        "name": "Traiter pièce",
        "func": "const p = msg.payload || {};\nconst total = Number(p.totalCount) || 0;\nconst ok = Number(p.conformeCount) || 0;\nconst ko = Number(p.defectTotal) || 0;\nconst prevTotal = flow.get(\"totalCount\");\n\nlet packedIds = flow.get(\"packedIds\") || {};\nlet packedCount = Number(flow.get(\"packedCount\")) || 0;\n\nif (prevTotal != null && total < Number(prevTotal)) {\n    packedIds = {};\n    packedCount = 0;\n    flow.set(\"qualityAlert\", false);\n}\n\nconst pieceId = p.id != null && p.id !== \"\" ? String(p.id) : \"\";\nif (p.packed && pieceId && !packedIds[pieceId]) {\n    packedIds[pieceId] = true;\n    packedCount += 1;\n}\n\nflow.set(\"packedIds\", packedIds);\nflow.set(\"packedCount\", packedCount);\nflow.set(\"totalCount\", total);\nflow.set(\"conformeCount\", ok);\nflow.set(\"defectTotal\", ko);\n\nconst trs = total > 0 ? Math.round((ok / total) * 1000) / 10 : 0;\nconst temp = Number(p.temp);\nconst rateNum = Number(p.defectRate);\nconst rate = Number.isFinite(rateNum) ? rateNum : 0;\nconst status = p.status || \"\";\nconst motif = p.motif || (status === \"Non-Conforme\" ? \"Défaut simulé\" : \"\");\n\nconst row = {\n    ID_Piece: pieceId,\n    Horodatage: p.timestamp || \"\",\n    Temp_Moule: Number.isFinite(temp) ? temp : \"\",\n    Statut: status,\n    Motif_Rebut: motif,\n    Emballe: p.packed ? \"Oui\" : \"Non\"\n};\n\nconst alertOn = rate > 30;\nconst wasAlert = !!flow.get(\"qualityAlert\");\nflow.set(\"qualityAlert\", alertOn);\n\nreturn [\n    { payload: row },\n    { payload: total },\n    { payload: ok },\n    { payload: ko },\n    { payload: packedCount },\n    { payload: trs },\n    Number.isFinite(temp) ? { payload: temp } : null,\n    { payload: rate, topic: \"Taux de rebut\" },\n    { payload: alertOn ? \"Alerte Qualité Majeure\" : \"—\" },\n    (alertOn && !wasAlert) ? { payload: \"Alerte Qualité Majeure — taux de rebut \" + rate + \" %\" } : null\n];",
        "outputs": 10,
        "timeout": 0,
        "noerr": 0,
